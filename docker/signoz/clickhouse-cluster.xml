<?xml version="1.0"?>
<!--
  FlowCore — SigNoz ClickHouse Cluster Configuration
  
  Defines a single-node cluster named "cluster" for SigNoz compatibility.
  This is required even for single-node deployments.
-->
<clickhouse>
    <remote_servers>
        <cluster>
            <shard>
                <replica>
                    <host>signoz-clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
        </cluster>
    </remote_servers>
    
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
    
    <macros>
        <cluster>cluster</cluster>
        <shard>1</shard>
        <replica>signoz-clickhouse-01</replica>
    </macros>
</clickhouse>
