          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  d.event_ts as time,\n  d.value,\n  c.canonical_metric_name as metric\nFROM metric_datapoint d\nJOIN metric_catalogue c ON d.metric_id = c.metric_id\nWHERE c.canonical_metric_name = 'pdu_outlet_current_a'\n  AND d.event_ts > NOW() - INTERVAL '30 days'\nORDER BY d.event_ts\nLIMIT 1000",
