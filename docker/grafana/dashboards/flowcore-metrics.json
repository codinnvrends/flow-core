          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  c.canonical_metric_name as metric,\n  COUNT(*) as sample_count,\n  MIN(d.value) as min_val,\n  MAX(d.value) as max_val,\n  AVG(d.value)::numeric(10,2) as avg_val\nFROM metric_datapoint d\nJOIN metric_catalogue c ON d.metric_id = c.metric_id\nWHERE d.event_ts > NOW() - INTERVAL '30 days'\nGROUP BY c.canonical_metric_name\nORDER BY sample_count DESC\nLIMIT 20",
